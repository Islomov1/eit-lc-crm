generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  password        String
  role            Role
  createdAt       DateTime         @default(now())
  groups          Group[]          @relation("TeacherGroups")
  parentInvites   ParentInvite[]   @relation("InvitesCreatedByUser")
  reports         Report[]         @relation("TeacherReports")
  supportSessions SupportSession[] @relation("SupportUser")
  expenses        Expense[]        @relation("ExpensesCreatedBy")
  payments        Payment[]
  sessions        Session[]
  disabledAt      DateTime?
}

model TelegramUpdate {
  id          String               @id @default(uuid())
  updateId    Int                  @unique
  payload     Json
  status      TelegramUpdateStatus @default(RECEIVED)
  error       String?
  createdAt   DateTime             @default(now())
  processedAt DateTime?
}

model ParentInvite {
  id          String       @id @default(uuid())
  code        String       @unique
  status      InviteStatus @default(ACTIVE)
  studentId   String
  createdById String?
  parentId    String?
  createdAt   DateTime     @default(now())
  usedAt      DateTime?
  expiresAt   DateTime?
  createdBy   User?        @relation("InvitesCreatedByUser", fields: [createdById], references: [id])
  parent      Parent?      @relation("InvitesUsedByParent", fields: [parentId], references: [id])
  student     Student      @relation(fields: [studentId], references: [id])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  name      String
  actorType String?
  actorId   String?
  groupId   String?
  studentId String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([studentId])
  @@index([groupId])
}

model Group {
  id         String       @id @default(uuid())
  name       String
  schedule   ScheduleType
  startTime  String
  endTime    String
  month      Int          @default(1)
  status     GroupStatus  @default(NEW)
  programId  String
  teacherId  String?
  createdAt  DateTime     @default(now())
  program    Program      @relation(fields: [programId], references: [id])
  teacher    User?        @relation("TeacherGroups", fields: [teacherId], references: [id])
  reports    Report[]
  lessons    Lesson[]
  students   Student[]
  payments   Payment[]
  archivedAt DateTime?
  monthlyFee Int          @default(750000)

  @@index([teacherId, schedule, archivedAt])
}

model Student {
  id                   String                @id @default(uuid())
  name                 String
  createdAt            DateTime              @default(now())
  phone                String?
  note                 String?
  archivedAt           DateTime?
  leads                Lead[]
  groups               Group[]
  parents              Parent[]
  payments             Payment[]
  ParentInvite         ParentInvite[]
  reports              Report[]
  lessonStudents       LessonStudent[]
  supportSessions      SupportSession[]
  telegramDeliveries   TelegramDelivery[]
  telegramPendingLinks TelegramPendingLink[]

  @@index([archivedAt, createdAt])
}

model Parent {
  reportLanguage       String                @default("BOTH")
  weeklyReports        Boolean               @default(true)
  id                   String                @id @default(uuid())
  name                 String
  phone                String
  telegramId           BigInt?
  createdAt            DateTime              @default(now())
  studentId            String
  student              Student               @relation(fields: [studentId], references: [id])
  invites              ParentInvite[]        @relation("InvitesUsedByParent")
  telegramDeliveries   TelegramDelivery[]
  telegramPendingLinks TelegramPendingLink[]

  @@index([studentId])
  @@index([phone])
  @@index([telegramId])
}

model TelegramPendingLink {
  id        String    @id @default(uuid())
  sessionId String
  chatId    BigInt
  parentId  String
  studentId String
  status    String    @default("PENDING")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, parentId])
  @@index([chatId, status])
  @@index([parentId])
  @@index([studentId])
  @@index([status])
}

model Report {
  topic      String?
  covered    String?
  assignment String?
  version    Int              @default(1)
  updatedAt  DateTime         @default(now()) @updatedAt
  revisions  ReportRevision[]
  id         String           @id @default(uuid())
  date       DateTime         @default(now())
  dateKey    String
  attendance AttendanceStatus
  homework   HomeworkStatus
  comment    String?
  studentId  String
  teacherId  String
  groupId    String
  group      Group            @relation(fields: [groupId], references: [id])
  student    Student          @relation(fields: [studentId], references: [id])
  teacher    User             @relation("TeacherReports", fields: [teacherId], references: [id])

  @@unique([studentId, groupId, dateKey])
  @@index([dateKey, attendance])
  @@index([groupId, dateKey])
}

model SupportSession {
  id        String   @id @default(uuid())
  startTime DateTime
  endTime   DateTime
  comment   String?
  createdAt DateTime @default(now())
  studentId String
  supportId String
  student   Student  @relation(fields: [studentId], references: [id])
  support   User     @relation("SupportUser", fields: [supportId], references: [id])
}

model Program {
  id     String  @id @default(uuid())
  name   String  @unique
  groups Group[]
}

model TelegramDelivery {
  autoRetry         Boolean                @default(false)
  cancelledAt       DateTime?
  sourceVersion     Int?
  id                String                 @id @default(uuid())
  studentId         String
  parentId          String
  chatId            BigInt
  messageText       String
  parseMode         String?
  actorType         String?
  actorId           String?
  sourceType        String?
  sourceId          String?
  idempotencyKey    String
  status            TelegramDeliveryStatus @default(PENDING)
  attemptCount      Int                    @default(0)
  lastAttemptAt     DateTime?
  nextRetryAt       DateTime?
  sentAt            DateTime?
  telegramMessageId Int?
  error             String?
  errorPayload      Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  parent            Parent                 @relation(fields: [parentId], references: [id])
  student           Student                @relation(fields: [studentId], references: [id])

  @@unique([parentId, idempotencyKey])
  @@index([status, nextRetryAt])
  @@index([studentId, createdAt])
  @@index([parentId, createdAt])
}

model Payment {
  id              String        @id @default(uuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id])
  teacherId       String?
  teacher         User?         @relation(fields: [teacherId], references: [id])
  groupId         String?
  group           Group?        @relation(fields: [groupId], references: [id])
  periodStart     DateTime
  periodEnd       DateTime
  classesIncluded Int           @default(12)
  amount          Int
  paidAmount      Int           @default(0)
  baseAmount      Int           @default(0)
  discountPct     Int           @default(0)
  bonus           Int           @default(0)
  status          PaymentStatus @default(PAID)
  method          PaymentMethod
  paidAt          DateTime      @default(now())
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([studentId, groupId, periodStart])
  @@index([teacherId, periodStart])
  @@index([studentId, periodStart])
  @@index([periodStart, periodEnd])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model LoginAttempt {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actorName String
  action    String
  entity    String
  entityId  String
  summary   String
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([createdAt])
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  actorName String
  text      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model LeadForm {
  id      String @id
  name    String
  program String
  learningFormat LearningFormat @default(UNKNOWN)
}

model IntegrationError {
  id         String    @id @default(uuid())
  service    String
  message    String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolvedAt, createdAt])
}

model Lead {
  id         String         @id @default(uuid())
  name       String
  phone      String?
  source     String?
  program    String?
  learningFormat LearningFormat @default(UNKNOWN)
  ownerId    String?
  followUpAt DateTime?
  trialAt    DateTime?
  lossReason String?
  archivedAt DateTime?
  studentId  String?
  student    Student?       @relation(fields: [studentId], references: [id])
  activities LeadActivity[]
  status     LeadStatus     @default(NEW)
  note       String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([ownerId, followUpAt])
  @@index([studentId])
}

model Expense {
  id          String   @id @default(uuid())
  amount      Int
  category    String
  description String?
  date        DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("ExpensesCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}

enum LearningFormat {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum LeadStatus {
  NEW
  ACTIVE
  FROZEN
  CONVERTED
  LOST
}

enum Role {
  ADMIN
  TEACHER
  SUPPORT
  DIRECTOR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum HomeworkStatus {
  DONE
  PARTIAL
  NOT_DONE
}

enum ScheduleType {
  MWF
  TTS
}

enum TelegramUpdateStatus {
  RECEIVED
  PROCESSED
  IGNORED
  ERROR
}

enum InviteStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

enum GroupStatus {
  NEW
  ACTIVE
  FINISHING
  EXPIRED
}

enum TelegramDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CLICK
  PAYME
  OTHER
}

enum PaymentStatus {
  PAID
  PARTIAL
  REFUND
  VOID
}

model ReportRevision {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  version   Int
  actorId   String
  actorName String
  reason    String
  before    Json?
  after     Json
  createdAt DateTime @default(now())

  @@unique([reportId, version])
}

model Lesson {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id])
  dateKey     String
  endTime     String
  topic       String?
  covered     String?
  assignment  String?
  cancelledAt DateTime?
  cancelReason String?
  createdAt   DateTime @default(now())
  students    LessonStudent[]

  @@unique([groupId, dateKey])
  @@index([dateKey])
}

model LessonStudent {
  lessonId  String
  studentId String
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id])

  @@id([lessonId, studentId])
  @@index([studentId])
}

model ReportAutomation {
  id               String    @id @default("parent-reports")
  trackingStartsOn String
  enabled          Boolean   @default(false)
  createdAt        DateTime  @default(now())
  lastRunAt        DateTime?
  lastSuccessAt    DateTime?
  lastError        String?
}
